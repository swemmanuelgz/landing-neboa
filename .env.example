# ====================================
# CONFIGURACIÓN DE RESERVAS - NÉBOA
# ====================================
# Este archivo contiene VALORES DE EJEMPLO
# Copia este archivo como .env y reemplaza con tus valores reales

# JWT Secret para autenticación con n8n
# Genera uno nuevo en: https://jwt.io
VITE_JWT_SECRET=tu_jwt_secret_aqui

# Webhook URL de n8n para procesar reservas
# Formato: https://tu-dominio.com/webhook/tu-uuid-unico
VITE_WEBHOOK_RESERVAS=https://tu-dominio.com/webhook/tu-uuid-aqui

# Google AdSense
# Formato client: ca-pub-xxxxxxxxxxxxxxxx
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Publisher ID (sin prefijo ca-)
VITE_GOOGLE_ADSENSE_PUB_ID=pub-xxxxxxxxxxxxxxxx

# Registro oficial para ads.txt
VITE_GOOGLE_ADSENSE_ADS_TXT_RECORD=google.com, pub-xxxxxxxxxxxxxxxx, DIRECT, f08c47fec0942fa0

# Supabase (horarios dinámicos)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
