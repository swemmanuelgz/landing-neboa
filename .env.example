# ====================================
# CONFIGURACIÓN DE RESERVAS - NÉBOA
# ====================================
# Este archivo contiene VALORES DE EJEMPLO
# Copia este archivo como .env y reemplaza con tus valores reales

# ⚠️ Autenticación JWT master/child:
#   - JWT_MASTER_SECRET (HMAC) → Supabase Edge Function "reservas-proxy" + n8n env var
#   - JWT_WEB_LANDING (hijo sub=web-landing) → secret de la Edge Function
#   - JWT_TELNYX_VOICE (hijo sub=telnyx-voice) → header del asistente Telnyx
#   - JWT_N8N_INTERNAL (hijo sub=n8n-internal) → credencial Header Auth en n8n
# NINGUNA va prefijada con VITE_ porque el frontend nunca envía el token;
# lo inyecta la Edge Function "reservas-proxy" antes de llamar al webhook n8n.
# Generar con:
#   JWT_MASTER_SECRET=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
#   node -e "const j=require('jsonwebtoken');const s=process.env.S;
#     ['web-landing','telnyx-voice','n8n-internal'].forEach(sub=>
#       console.log(sub+'='+j.sign({sub,aud:'n8n-reservas',iss:'neboa-landing'},s,{algorithm:'HS256',expiresIn:'365d'})))" S="$JWT_MASTER_SECRET"

# Google AdSense
# Formato client: ca-pub-xxxxxxxxxxxxxxxx
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Publisher ID (sin prefijo ca-)
VITE_GOOGLE_ADSENSE_PUB_ID=pub-xxxxxxxxxxxxxxxx

# Registro oficial para ads.txt
VITE_GOOGLE_ADSENSE_ADS_TXT_RECORD=google.com, pub-xxxxxxxxxxxxxxxx, DIRECT, f08c47fec0942fa0

# Supabase (horarios dinámicos)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
